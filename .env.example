# Copy this file to .env.local for local work, and set the same values in your
# hosting provider for the deployed site.
#
# Nothing in here belongs in git. .env.local is already ignored.
# Every variable the code reads is listed here — a test enforces that.

# ── Always needed ────────────────────────────────────────────────────────────

# Your database, from neon.com. Starts with postgresql://
DATABASE_URL=

# openssl rand -hex 32
# Keys the hashing of sessions and one-time links. Set it once and leave it
# alone: changing it signs every student out and invalidates unused links.
SESSION_SECRET=

# openssl rand -hex 32
# Must be the IDENTICAL value in your funnel. If they differ, every enrolment
# call is rejected and nobody gets access to what they bought.
FUNNEL_SHARED_SECRET=

# Your own email address. This is how the platform knows which account is
# yours. Without it nobody is the owner, /owner is not reachable by anyone,
# and you get no warning before a free tier runs out.
OWNER_EMAIL=

# ── Sending email ────────────────────────────────────────────────────────────
# Only the ones for the provider you chose in course.config.ts.
# See docs/choosing-an-email-sender.md

# provider: 'gmail' — an app password, NOT your normal Gmail password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# provider: 'resend'
RESEND_API_KEY=

# provider: 'smtp' or 'ses'
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Your video host ──────────────────────────────────────────────────────────
# Only the ones for the host you chose. YouTube, Vimeo, Loom and custom embeds
# need nothing here. See docs/choosing-a-video-host.md

# Bunny. Without the token key the video plays but the link can be shared.
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# Mux. Without these it plays from a public id, which anyone can share.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Cloudflare Stream
CLOUDFLARE_STREAM_CUSTOMER_CODE=
